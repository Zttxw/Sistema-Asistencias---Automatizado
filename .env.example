# ============================================================
# Variables de entorno para docker-compose.yml
# Copiar este archivo como ".env" y ajustar los valores:
#   copy .env.example .env   (Windows CMD)
#   cp .env.example .env     (PowerShell / Git Bash)
# ============================================================

# === Configuración del Servidor ===
# IP o hostname de la PC donde corre Docker Desktop.
# - Usar "localhost" para acceder desde la misma PC.
# - Usar la IP LAN (ej. 192.168.1.100) si otras PCs de la oficina
#   necesitan acceder al backend o al dashboard web.
#   Obtener con: ipconfig (buscar "Dirección IPv4" en la interfaz Ethernet/Wi-Fi).
SERVER_HOST=localhost

# URL del API que se inyecta en el frontend durante el build.
# Debe coincidir con SERVER_HOST. Si SERVER_HOST cambia, esta también.
VITE_API_URL=http://${SERVER_HOST}:8010

# === Base de Datos MySQL ===
MYSQL_DB=asistencias
MYSQL_USER=asistencias_user
MYSQL_PASSWORD=CAMBIAR_PASSWORD_SEGURA
MYSQL_ROOT_PASSWORD=CAMBIAR_ROOT_PASSWORD_SEGURA
