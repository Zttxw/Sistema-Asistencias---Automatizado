# ============================================================
# Variables de entorno para docker-compose.yml
# Copiar este archivo como ".env" y ajustar los valores:
#   cp .env.example .env
# ============================================================

# === Configuración del Servidor VM ===
SERVER_HOST=10.0.30.50
VITE_API_URL=http://10.0.30.50:8082

# === Agente de Asistencia (PC local Windows) ===
AGENTE_HTTP_URL=http://192.168.0.104:5050
AGENTE_SECRET_TOKEN=<GENERAR_TOKEN_RANDOM_SEGURO>

# === Base de Datos MySQL ===
MYSQL_DB=asistencias_db
MYSQL_USER=asistencias_user
MYSQL_PASSWORD=<GENERAR_PASSWORD_SEGURA>
MYSQL_ROOT_PASSWORD=<GENERAR_ROOT_PASSWORD_SEGURA>

