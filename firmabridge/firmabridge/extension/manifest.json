{
  "manifest_version": 3,
  "name": "FirmaBridge",
  "description": "Lanza el Firmador de FirmaPeru automaticamente en Chrome, resolviendo la incompatibilidad de ClickOnce.",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "webNavigation"
  ],
  "host_permissions": [
    "https://resources.firmaperu.gob.pe/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  }
}
